NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Order notifications (server-side only, set in Vercel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
ORDER_NOTIFY_EMAIL=
# ORDER_EMAIL_FROM="ASSORTE <orders@your-domain>"

# LiqPay online payment (set in Vercel when the merchant account exists)
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# LIQPAY_SANDBOX=1   # test payments only

# Public address of the site. Set ONLY for Production on the real domain: it also switches indexing on.
# While it is unset (or a *.vercel.app address) the whole site is noindex and robots.txt disallows everything.
# NEXT_PUBLIC_SITE_URL=https://example.com

